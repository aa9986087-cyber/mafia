// The Mafia game on Cloudflare Workers (free plan): the pages and the rooms in one Worker named "mafia",
// separate from every other game. Cloudflare builds it from the repository root on every push to main.
{
  "$schema": "server/node_modules/wrangler/config-schema.json",
  "name": "mafia",
  "main": "server/worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  // Copy just the pages (index.html, css, js, assets) into server/public before each deploy.
  "build": { "command": "node server/copy-pages.mjs" },
  "assets": { "directory": "./server/public", "run_worker_first": ["/ws/*"] },
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "MafiaGame" }] },
  // SQLite-backed Durable Objects are the ones available on the free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MafiaGame"] }],
  "observability": { "enabled": true }
}
