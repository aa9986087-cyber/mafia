// The Mafia server: Cloudflare Workers + Durable Objects (free plan), separate from every other game.
// Cloudflare deploys it from this folder (root directory "server") on every push to main.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mafia-server",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  // The game's pages are served from here too, so the game works on this address as well as on GitHub
  // Pages. copy-pages.mjs puts just the pages into public/ before each deploy; rooms (/ws/*) reach the worker.
  "build": { "command": "node copy-pages.mjs" },
  "assets": { "directory": "./public", "run_worker_first": ["/ws/*"] },
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "MafiaGame" }] },
  // SQLite-backed Durable Objects are the ones available on the free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MafiaGame"] }],
  "observability": { "enabled": true }
}
